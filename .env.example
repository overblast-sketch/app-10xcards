# Supabase: URL projektu i klucz anon (nigdy service_role). Wartosci z dashboardu
# Supabase, Project Settings -> API. Dla `wrangler dev` skopiuj do .dev.vars.
SUPABASE_URL=
SUPABASE_KEY=

# Dostawca AI: "mock" (deterministyczne kandydaty, bez sieci; uzywany w testach)
# albo "openrouter" (wymaga klucza z limitem wydatkow).
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
