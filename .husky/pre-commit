npx lint-staged

# Bramka sekretow (test-plan, os bezpieczenstwa): wzorce prawdziwych kluczy,
# nie samych slow, zeby dokumentacja o sekretach nie blokowala commitow.
# - klucz OpenRouter: sk-or-v1-<hex>
# - JWT Supabase (anon lub service_role): eyJhbGciOi...
# - przypisanie klucza service role: SERVICE_ROLE...=<wartosc>
PATTERN='sk-or-v1-[A-Za-z0-9]{16,}|eyJhbGciOi[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|SERVICE_ROLE[A-Z_]*=[^ ]{10,}'
if git diff --cached -U0 -- . ':(exclude).husky/pre-commit' | grep -E '^\+[^+]' | grep -E "$PATTERN" >/dev/null; then
  echo "pre-commit: staged diff zawiera cos, co wyglada na sekret (klucz OpenRouter, JWT Supabase, service role). Commit odrzucony." >&2
  exit 1
fi
