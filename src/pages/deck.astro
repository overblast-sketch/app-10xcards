---
import AppShell from "@/layouts/AppShell.astro";
import DeckList from "@/components/deck/DeckList";
import { getGeneration, listFlashcards } from "@/lib/services/generation.service";

const { supabase } = Astro.locals;
const flashcards = supabase ? await listFlashcards(supabase) : [];

const savedId = Astro.url.searchParams.get("saved");
const savedGeneration = supabase && savedId ? await getGeneration(supabase, savedId) : null;
---

<AppShell title="Deck">
  <h1 class="mb-2 text-3xl font-bold" data-testid="page-title">Twój deck</h1>
  <p class="mb-6 text-blue-100/70">Fiszki, które zaakceptowałeś. Najnowsze na górze. Możesz je poprawiać i usuwać.</p>

  {
    savedGeneration?.status === "saved" && (
      <div
        class="mb-6 rounded-xl border border-emerald-400/40 bg-emerald-500/10 p-4 text-sm text-emerald-50"
        data-testid="generation-summary"
      >
        <strong>Zapisano generację.</strong> Wygenerowano {savedGeneration.generated_count}, zaakceptowano{" "}
        {savedGeneration.accepted_count}, po edycji {savedGeneration.edited_count}, odrzucono{" "}
        {savedGeneration.rejected_count}. Do decka trafiło{" "}
        {savedGeneration.accepted_count + savedGeneration.edited_count} fiszek.
      </div>
    )
  }

  <DeckList initialCards={flashcards} client:load />
</AppShell>
